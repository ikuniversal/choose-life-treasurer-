# Copy to .env.local and fill in. Both are public-by-design client keys
# (safe in the browser) — never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (Vercel project env — added by operator, not committed here)
SUPABASE_SERVICE_ROLE_KEY=
