# Copy to .env.local and fill in. Both are public-by-design client keys
# (safe in the browser) — never put the service-role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (Vercel project env — added by operator, not committed here).
# The new-style sb_secret_… key, not the legacy service_role key.
SUPABASE_SECRET_KEY=

# Server-only — Azure AI Document Intelligence (receipt OCR). When BOTH are set,
# /capture runs real OCR; when either is missing, capture silently uses manual entry.
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=
